# URL de la API REST para clasificación
API_URL=https://api.ejemplo.com

# Directorio a escanear (default: directorio actual)
ROOT_DIR=.

# Extensiones a incluir, separadas por coma (vacío = todas)
EXTENSIONS=txt,pdf,md,rs,py,js,json

# Tamaño máximo de archivo en MB
MAX_FILE_SIZE_MB=10

# Timeout de API en segundos
API_TIMEOUT_SECS=30

# Incluir archivos ocultos (true/false)
INCLUDE_HIDDEN=false

# Número máximo de archivos a procesar (0 = ilimitado)
MAX_FILES=0

# Número de workers concurrentes
CONCURRENCY=4

# API Key para autenticación (opcional)
API_KEY=your-api-key-here

# Logging verbose (true/false)
VERBOSE=false
